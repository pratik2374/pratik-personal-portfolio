rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything is denied unless a rule below allows it.
    // Site content lives in Sanity; Firestore only receives contact-form messages.
    // Read messages in the Firebase console (Admin access bypasses these rules).

    function isValidMessage(data) {
      return data.keys().hasOnly(['name', 'email', 'budget', 'message', 'createdAt'])
        && data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && (!('budget' in data) || (data.budget is string && data.budget.size() <= 50))
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 5000
        && data.createdAt == request.time;
    }

    match /messages/{messageId} {
      allow create: if isValidMessage(request.resource.data);
    }
  }
}
